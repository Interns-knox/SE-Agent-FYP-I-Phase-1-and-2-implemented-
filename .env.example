# ---------------------------------------------------------------------------
# SE Agent (FYP-I) configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL used by the platform itself (workspaces, features, artifacts, history)
DATABASE_URL=postgresql+psycopg2://se_agent:CHANGE_ME@localhost:5432/se_agent

# Ollama (local language model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_PROVIDER=ollama
# Seconds to wait for one model call (a domain model can take 4-5 minutes on a modest GPU)
LLM_TIMEOUT_SECONDS=600
# Optional: context window in tokens and Qwen3 "thinking" switch (false is much faster)
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false

# PlantUML executable used to validate and render UML diagrams locally (see README)
PLANTUML_COMMAND=plantuml

# Browser origins allowed to call the API, and the API URL the frontend uses
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
